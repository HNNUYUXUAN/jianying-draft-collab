AUDIO_PROVIDER=volc_agent_plan
TTS_MODEL=doubao-seed-tts-2.0
TTS_VOICE=zh_female_vv_uranus_bigtts
TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
TTS_RESOURCE_ID=seed-tts-2.0
TTS_NATIVE_SAMPLE_RATE=24000
TTS_SAMPLE_RATE=48000
TTS_SPEECH_RATE=0
ASR_MODEL=doubao-seed-asr-2.0
ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_nostream
ASR_RESOURCE_ID=volc.seedasr.sauc.duration
HTTP_TIMEOUT_SECONDS=120
ASR_MAX_SECONDS=60
ASR_MAX_BYTES=9500000
SUBTITLE_MAX_CHARS=14
SUBTITLE_MAX_MS=5500
SUBTITLE_MIN_MS=1200
SUBTITLE_GAP_MS=80
VOLC_AGENT_API_KEY=

# Full FFmpeg is provisioned in runtime/tools/ffmpeg/bin by bootstrap -Repair.
VISION_MODEL=doubao-seed-2.1-pro
