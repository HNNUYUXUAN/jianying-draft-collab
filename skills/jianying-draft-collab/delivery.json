  "requirements": [
    {
      "id": "windows-codex",
      "kind": "host",
      "handling": "Windows 11 x64 with Codex and stock PowerShell; use recipient-provided host file/terminal/browser tools."
    },
    {
      "id": "python-video",
      "kind": "rebuild",
      "handling": "Bootstrap locked portable Python and core dependency hashes; reuse verified configured environments."
    },
    {
      "id": "python-music",
      "kind": "rebuild",
      "handling": "Independent locked music venv, pinned music-production renderer and selected CC0 VCSL/VSCO banks."
    },
    {
      "id": "media-tools",
      "kind": "rebuild",
      "handling": "Download locked FFmpeg and FluidSynth from official sources; preserve notices and verify actual render/decode."
    },
    {
      "id": "jianying",
      "kind": "host",
      "handling": "Recipient installs editor. Select the working installation; verify required native operations in isolated copies and cache fingerprints locally."
    },
    {
      "id": "agent-plan",
      "kind": "configure",
      "handling": "Runtime .env or process variables, process first. Own credentials; configuration and real cloud validation separate. Existing audio and local music need no cloud key."
    },
    {
      "id": "chrome-chatgpt",
      "kind": "host",
      "handling": "Host-connected Chrome for new explanatory images; verify login, Create image and original downloads separately."
    },
    {
      "id": "footage-and-brief",
      "kind": "input",
      "handling": "User footage, intended edits and destination; preserve originals and saved user drafts."
    }
  ]
